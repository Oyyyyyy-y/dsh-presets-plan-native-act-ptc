{
  "name": "dsh-presets-plan-native-act-ptc",
  "version": "0.1.4",
  "description": "DeepSeek Harness preset: one cache-stable superset tool catalog, plan mode enforces the standard preset's tools and approved execution enforces stock PTC (run_code only).",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./plugins/*": "./plugins/*.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs",
    "plugins",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "locale"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.svg",
  "scripts": {
    "test": "node scripts/test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "preset",
    "plan-mode",
    "ptc",
    "run-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oyyyyyy-y/dsh-presets-plan-native-act-ptc.git"
  },
  "homepage": "https://github.com/Oyyyyyy-y/dsh-presets-plan-native-act-ptc#readme"
}
